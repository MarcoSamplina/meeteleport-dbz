{
  "manifest_version": 3,
  "name": "Meet Teleport",
  "version": "0.1.0",
  "description": "Pasa tu cámara por la extensión antes de que llegue a Google Meet. En esta fase la imagen se reenvía tal cual.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Meet Teleport",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
