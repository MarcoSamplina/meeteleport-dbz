{
  "manifest_version": 3,
  "name": "Meet Teleport",
  "version": "0.3.2",
  "description": "Desaparece de Google Meet con dos dedos en la frente. La llamada ve tu habitación vacía.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-vanish": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Entrar o salir de la habitación vacía"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Meet Teleport",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["src/gesture-rules.js", "src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
